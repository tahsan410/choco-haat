# ───────────── Frontend (safe to expose; prefixed with VITE_) ─────────────
# Supabase project URL and the *anon* (public) key. NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of the deployed site (used for SEO canonical / Open Graph tags)
VITE_SITE_URL=https://your-site.netlify.app

# Demo mode runs the whole shop on browser localStorage (no backend) when Supabase is
# not configured. Great for local development. Keep it "false" in production.
VITE_ENABLE_DEMO_MODE=true

# ───────────── Server-side only (Netlify environment variables) ─────────────
# Used by Netlify Functions. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (service account) – see README "Google Sheets setup"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key exactly as in the JSON file (with \n sequences) inside double quotes
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Orders
